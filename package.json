{
  "name": "@skedox/analytics-monorepo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "build:core": "npm run build -w @skedox/core",
    "build:vanilla": "npm run build -w @skedox/vanilla",
    "build:react": "npm run build -w @skedox/react",
    "build:vue": "npm run build -w @skedox/vue",
    "dev": "npm run dev --workspaces --if-present",
    "clean": "rm -rf packages/*/dist",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "react": "^19.0.0",
    "typescript": "~5.9.3",
    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-dts": "^4.5.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
