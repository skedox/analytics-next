{
  "name": "@skedox/analytics-react",
  "version": "1.0.0",
  "description": "Skedox Analytics SDK for React - hooks and components for web analytics",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "analytics",
    "tracking",
    "skedox",
    "react",
    "hooks"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skedox/analytics-next.git",
    "directory": "packages/react"
  },
  "dependencies": {
    "@skedox/analytics-core": "^1.0.0"
  },
  "peerDependencies": {
    "react": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": false
    }
  },
  "sideEffects": false
}
