{
  "name": "@skedox/core",
  "version": "0.0.1",
  "description": "Core analytics engine for Skedox - shared logic for all SDK variants",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "analytics",
    "tracking",
    "skedox"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skedox/analytics.git",
    "directory": "packages/core"
  },
  "sideEffects": false
}
